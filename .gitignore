# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Claude Code local settings — command history here has embedded API
# keys/tokens from approved Bash calls, must never be committed
.claude/

# security / pentest reports — don't want live vulnerability details
# sitting in git history
pentest.md
PENTEST-REPORT.md

# full raw DB dumps — large and contain real user/business data;
# migration/clone_01_schema.sql and clone_03_post_data.sql (structure
# only, no data) stay tracked as schema documentation
clone_completo.sql
migration/clone_02_data.sql
migration/backup_full.sql

# project standardizes on yarn; a stray package-lock.json causes
# mixed-package-manager installs
package-lock.json
